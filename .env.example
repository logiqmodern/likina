# Copy to .env and fill in. Never commit .env.
# Phase in brackets = when the variable becomes required.
# Hosting: Vercel (Pro — the Hobby plan is non-commercial only) + Neon Postgres.

# ── Core [0] ──────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000    # on Vercel optional: derived from the deployment URL
DATABASE_URL=postgres://app:app@localhost:5432/app
DATABASE_URL_UNPOOLED=           # Neon: direct connection for migrations/seed (vercel-build)

# ── Admin auth [0] ────────────────────────────────────────
SESSION_SECRET=                  # >= 32 random chars: openssl rand -base64 48 (also encrypts 2FA secrets — never rotate casually)
# One-time: enables /admin/nastroyka to create the first (developer) user while
# there are no admin users. >= 24 chars: openssl rand -base64 32. Remove after use.
ADMIN_SETUP_TOKEN=

# ── Anti-spam [4] ─────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── E-mail (Resend) [6] ───────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Likina <shop@likina.com>"   # TODO-CLIENT: sender domain needs DNS (SPF/DKIM) on likina.com
EMAIL_REPLY_TO=iconslikina@gmail.com
STUDIO_NOTIFY_EMAIL=iconslikina@gmail.com   # seller notifications (new order, failed payment, inquiry)
ALERT_EMAIL=                     # developer alerts
RESEND_WEBHOOK_SECRET=           # whsec_… from Resend → Webhooks
CRON_SECRET=                     # ≥ 16 chars; protects /api/cron/* (Vercel Cron sends it as Bearer)

# ── Payments: myPOS Checkout [6] — production + test store, never in the repo or the chat ──
MYPOS_MODE=test                  # test | production
MYPOS_SID=                       # Store ID
MYPOS_WALLET_NUMBER=             # Client Number
MYPOS_KEY_INDEX=
MYPOS_PRIVATE_KEY=               # PEM, our private key (signs requests)
MYPOS_PUBLIC_CERT=               # PEM, myPOS public certificate (verifies notifications)

# ── Shipping: Econt API [v1.1] ────────────────────────────
ECONT_API_USER=
ECONT_API_PASSWORD=
ECONT_API_MODE=demo              # demo | production

# ── Notifications: Telegram [6] ───────────────────────────
TELEGRAM_BOT_TOKEN=              # from the old WordPress plugin "Likina Telegram Notifications"
TELEGRAM_CHAT_ID=

# ── Automatic EN translation: Claude API [v1.1] ──────────
ANTHROPIC_API_KEY=

# ── Measurement [8] ───────────────────────────────────────
# NEXT_PUBLIC_* are inlined at BUILD time. Nothing loads before the visitor's consent (ADR 0004).
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Monitoring [9] ────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Search engines: "on" only on the production domain at launch; otherwise noindex + robots Disallow.
SITE_INDEXING=
