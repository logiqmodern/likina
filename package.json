{
  "name": "likina",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "esbuild src/worker/index.ts scripts/migrate.ts scripts/seed.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outdir=dist --out-extension:.js=.mjs",
    "start": "next start",
    "worker:dev": "tsx watch src/worker/index.ts",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "check": "npm run lint && npm run typecheck && npm test",
    "db:seed": "tsx scripts/seed.ts",
    "vercel-build": "npm run db:migrate && npm run db:seed && tsx scripts/import-legacy.ts --if-empty && tsx scripts/translate-missing.ts && next build",
    "e2e": "tsx e2e/prepare.ts && playwright test"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@node-rs/argon2": "^2.2.2",
    "@react-email/components": "^1.0.12",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "otpauth": "^9.6.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "temporal-polyfill": "^1.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12 <23"
  }
}
